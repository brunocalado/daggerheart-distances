<div class="dhd-visual-settings-form">

    <div class="form-group">
        <label>{{localize "DHD.settings.textSize.name"}}</label>
        <div class="form-fields">
            <select name="textSize">
                {{#each textSize.choices}}
                <option value="{{@key}}" {{#if (eq @key ../textSize.value)}}selected{{/if}}>{{this}}</option>
                {{/each}}
            </select>
        </div>
        <p class="hint">{{localize "DHD.settings.textSize.hint"}}</p>
    </div>

    <div class="form-group">
        <label>{{localize "DHD.settings.colorPalette.name"}}</label>
        <div class="form-fields">
            <select name="colorPalette">
                {{#each colorPalette.choices}}
                <option value="{{@key}}" {{#if (eq @key ../colorPalette.value)}}selected{{/if}}>{{this}}</option>
                {{/each}}
            </select>
        </div>
        <p class="hint">{{localize "DHD.settings.colorPalette.hint"}}</p>
    </div>

    <div class="form-group">
        <label>{{localize "DHD.settings.lineStyle.name"}}</label>
        <div class="form-fields">
            <select name="lineStyle">
                {{#each lineStyle.choices}}
                <option value="{{@key}}" {{#if (eq @key ../lineStyle.value)}}selected{{/if}}>{{this}}</option>
                {{/each}}
            </select>
        </div>
        <p class="hint">{{localize "DHD.settings.lineStyle.hint"}}</p>
    </div>

    <div class="form-group">
        <label>{{localize "DHD.settings.lineThickness.name"}}</label>
        <div class="form-fields">
            <select name="lineThickness">
                {{#each lineThickness.choices}}
                <option value="{{@key}}" {{#if (eq @key ../lineThickness.value)}}selected{{/if}}>{{this}}</option>
                {{/each}}
            </select>
        </div>
        <p class="hint">{{localize "DHD.settings.lineThickness.hint"}}</p>
    </div>

    <div class="form-group">
        <label>{{localize "DHD.settings.fillStyle.name"}}</label>
        <div class="form-fields">
            <select name="fillStyle">
                {{#each fillStyle.choices}}
                <option value="{{@key}}" {{#if (eq @key ../fillStyle.value)}}selected{{/if}}>{{this}}</option>
                {{/each}}
            </select>
        </div>
        <p class="hint">{{localize "DHD.settings.fillStyle.hint"}}</p>
    </div>

    <div class="form-group">
        <label>{{localize "DHD.settings.targetHighlighting.name"}}</label>
        <div class="form-fields">
            <input type="checkbox" name="targetHighlighting" value="true" {{#if targetHighlighting}}checked{{/if}}>
        </div>
        <p class="hint">{{localize "DHD.settings.targetHighlighting.hint"}}</p>
    </div>

    <footer class="sheet-footer flexrow">
        <button type="submit"><i class="fas fa-save"></i> {{localize "DHD.visualSettings.saveChanges"}}</button>
    </footer>

</div>
